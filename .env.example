# RippleBack environment template.
#
# Copy to `.env` and fill in what you need. Every value is optional: with an
# empty `.env` the app runs on SQLite with the seeded demo scenarios, writes
# DISABLED, and every integration reported as "not configured". Real secrets
# belong here and must never be committed (`.env` is git-ignored).

# ── MCP server ───────────────────────────────────────────────────────────────
RIPPLEBACK_HOST=127.0.0.1
RIPPLEBACK_PORT=8000

# ── Local API adapter (the only MCP client; also serves the built frontend) ───
# Where the adapter's MCP client connects.
RIPPLEBACK_MCP_URL=http://127.0.0.1:8000/mcp
# Bind address. Keep loopback: the MCP session must not be exposed publicly.
RIPPLEBACK_ADAPTER_HOST=127.0.0.1
RIPPLEBACK_ADAPTER_PORT=8001
# Browser origins allowed to call the adapter (comma-separated).
RIPPLEBACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per-turn tool-call budget for the assistant (bounds runaway workflows).
RIPPLEBACK_MAX_TOOL_CALLS=8

# ── Persistence ──────────────────────────────────────────────────────────────
# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://...).
# RIPPLEBACK_DB_URL wins over DATABASE_URL.
RIPPLEBACK_DB_URL=sqlite:///./rippleback.db

# ── Writes (plan changes) ────────────────────────────────────────────────────
# Writes stay OFF until this is true. Every plan change still needs a dry-run
# confirm token plus a unique idempotency key.
RIPPLEBACK_WRITES_ENABLED=false
# When set, mutating adapter routes require `Authorization: Bearer <key>` and
# write tool calls require it too. STRONGLY recommended before any non-loopback
# bind: writes are refused outright on a public bind without it.
RIPPLEBACK_API_KEY=
# Signing secret for confirm tokens. Leave blank to auto-generate one and store
# it in the database (shared by the server and adapter processes).
RIPPLEBACK_TOKEN_SECRET=
# How long a dry-run confirm token stays valid, in seconds.
RIPPLEBACK_CONFIRM_TOKEN_TTL_SECONDS=300

# ── Project-management provider (plan import + optional write-back) ──────────
# none | jira | linear | github
RIPPLEBACK_PM_PROVIDER=none
# Push committed recoveries back to the PM (default off; commits go to the
# outbox and are retried, never lost).
RIPPLEBACK_PM_WRITEBACK_ENABLED=false
# Periodic sync + incident ingest + outbox drain interval, in seconds (0 = off).
RIPPLEBACK_SYNC_INTERVAL_SECONDS=300
# Dependency links that reference an entity outside the imported project:
# stub (default: keep a clearly-labeled stub entity) | error (reject the import).
RIPPLEBACK_OUT_OF_SCOPE_LINKS=stub
# Default per-resource capacity when no RESOURCES_FILE supplies one.
RIPPLEBACK_DEFAULT_CAPACITY=3
# YAML file mapping resource ids to capacities: {resources: [{id, capacity}]}.
RESOURCES_FILE=
# Optional: the entity that must be done before everything else (release gate).
RIPPLEBACK_RELEASE_ENTITY=
# Optional: substitute catalog YAML: {scenario_id: {entity_id: [substitute_id]}}.
SUBSTITUTES_FILE=

# ── Jira (RIPPLEBACK_PM_PROVIDER=jira) ───────────────────────────────────────
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Optional overrides (sensible defaults are used when unset).
JIRA_JQL=
# "In Review:in_progress,Blocked:blocked" — statuses: pending|in_progress|done|blocked
JIRA_STATUS_MAP=
# Custom field ids to read effort (number), duration (number), and cost (number).
JIRA_FIELD_EFFORT=
JIRA_FIELD_DURATION=
JIRA_FIELD_COST=
# Label that marks an issue blocked (unless it is already done).
JIRA_BLOCKED_LABEL=blocked

# ── Linear (RIPPLEBACK_PM_PROVIDER=linear) ───────────────────────────────────
LINEAR_API_KEY=
LINEAR_TEAM_KEY=
LINEAR_STATUS_MAP=
LINEAR_FIELD_EFFORT=
LINEAR_BLOCKED_LABEL=blocked

# ── GitHub Projects (RIPPLEBACK_PM_PROVIDER=github) ──────────────────────────
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
GITHUB_STATUS_MAP=
GITHUB_BLOCKED_LABEL=blocked
GITHUB_BLOCKED_BY_PATTERN=
GITHUB_LABEL_EFFORT_PREFIX=
GITHUB_LABEL_DURATION_PREFIX=

# ── PagerDuty incidents (feeds the risk metric; read-only) ───────────────────
PAGERDUTY_API_KEY=
# "SERVICE_ID:entity_id,SERVICE_ID:entity_id"
PAGERDUTY_SERVICE_MAP=
PAGERDUTY_SINCE_DAYS=30
PAGERDUTY_SCENARIO_ID=incidents

# ── Notifications (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Comma-separated allow-list of events to send; empty = all events.
# e.g. sync_failed,writeback_failed
NOTIFY_EVENTS=

# ── Scoring weights and cost model ───────────────────────────────────────────
# Leave blank for auto: a metric lightens up at weight 1.0 only when its data
# source is configured AND every option has a value. Set a float to force it.
# `resource_strain` is opt-in (env only) because capacity data is caller-supplied.
SCORE_WEIGHT_DELAY=
SCORE_WEIGHT_COST=
SCORE_WEIGHT_RISK=
SCORE_WEIGHT_STRAIN=
SCORE_WEIGHT_DISRUPTION=
# Cost = COST_PER_CHANGE * changes + rework (effort * rate, or a PM cost field).
COST_RATE_PER_WORK_UNIT=
COST_PER_CHANGE=

# ── Assistant (optional) ─────────────────────────────────────────────────────
# deterministic (default, offline, no credentials) | bedrock (optional).
RIPPLEBACK_ASSISTANT_PROVIDER=deterministic
# Required only when the bedrock provider is selected; no model id is guessed.
RIPPLEBACK_BEDROCK_REGION=
RIPPLEBACK_BEDROCK_MODEL_ID=
# AWS credentials are NEVER set here — use the standard backend chain
# (env vars / ~/.aws profile / instance role). They never reach the browser.
