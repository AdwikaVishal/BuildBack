# RippleBack frontend configuration (Vite).
#
# Vite exposes these to the browser, so ONLY put non-secret values here.
# Never place API keys, tokens, or passwords in a VITE_* variable: anything
# prefixed with VITE_ is compiled into the client bundle and is fully public.

# Serve the UI from captured fixtures instead of the live backend.
# Leave this unset (or "false") for normal use; "true" runs the dashboard
# fully offline for screenshots/demos.
VITE_MOCK_MODE=false

# Only used by `vite.config.ts` on the Node side (not exposed to the browser):
# the port the dev server proxies /api/* to. Must match RIPPLEBACK_ADAPTER_PORT
# on the adapter. Defaults to 8001 when unset.
# RIPPLEBACK_ADAPTER_PORT=8001
